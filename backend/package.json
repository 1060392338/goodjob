{
  "name": "goodjob-crm-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:mysql": "cross-env CRM_STORE=mysql tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:mysql": "cross-env CRM_STORE=mysql node dist/server.js",
    "provision:beta-admins": "tsx src/provision-beta-admins.ts",
    "test": "npm run test:self && npm run test:workflow:ai && npm run test:workflow:persistence && npm run test:vault && npm run test:repository:lead-outreach && npm run test:pipeline:lead-ingestion && npm run test:connector:file-leads && npm run test:connector:web-leads",
    "test:security": "cross-env NODE_ENV=test JWT_SECRET=goodjob-security-test-secret-at-least-32-characters tsx src/security-test.ts",
    "test:routes": "npm run test:routes:core && npm run test:routes:customers && npm run test:routes:leads && npm run test:routes:lead-outreach && npm run test:routes:lead-conversion && npm run test:gateway:model && npm run test:routes:ai-config && npm run test:connector:lead-source && npm run test:routes:lead-source-config",
    "test:routes:core": "cross-env NODE_ENV=test JWT_SECRET=goodjob-route-test-secret-at-least-32-characters tsx src/routes/routes-test.ts",
    "test:routes:customers": "cross-env NODE_ENV=test JWT_SECRET=goodjob-route-test-secret-at-least-32-characters tsx src/routes/customer-routes-test.ts",
    "test:routes:leads": "cross-env NODE_ENV=test JWT_SECRET=goodjob-route-test-secret-at-least-32-characters tsx src/routes/lead-routes-test.ts",
    "test:routes:lead-outreach": "cross-env NODE_ENV=test JWT_SECRET=goodjob-route-test-secret-at-least-32-characters tsx src/routes/lead-outreach-routes-test.ts",
    "test:routes:lead-conversion": "cross-env NODE_ENV=test JWT_SECRET=goodjob-route-test-secret-at-least-32-characters tsx src/routes/lead-conversion-routes-test.ts",
    "test:gateway:model": "cross-env NODE_ENV=test JWT_SECRET=goodjob-route-test-secret-at-least-32-characters tsx src/gateways/model-gateway-test.ts",
    "test:routes:ai-config": "cross-env NODE_ENV=test JWT_SECRET=goodjob-route-test-secret-at-least-32-characters tsx src/routes/ai-config-routes-test.ts",
    "test:connector:lead-source": "cross-env NODE_ENV=test JWT_SECRET=goodjob-route-test-secret-at-least-32-characters tsx src/connectors/lead-source-connector-test.ts",
    "test:routes:lead-source-config": "cross-env NODE_ENV=test JWT_SECRET=goodjob-route-test-secret-at-least-32-characters tsx src/routes/lead-source-config-routes-test.ts",
    "test:self": "cross-env NODE_ENV=test tsx src/self-test.ts",
    "test:workflow:ai": "cross-env NODE_ENV=test tsx src/ai/ai-workflow-engine-test.ts",
    "test:vault": "cross-env NODE_ENV=test tsx src/security/secret-vault-test.ts",
    "test:repository:lead-outreach": "cross-env NODE_ENV=test tsx src/persistence/lead-outreach-repository-test.ts",
    "test:workflow:persistence": "cross-env NODE_ENV=test tsx src/ai/mysql-ai-workflow-persistence-test.ts",
    "test:pipeline:lead-ingestion": "cross-env NODE_ENV=test tsx src/domain/leads/lead-ingestion-pipeline-test.ts",
    "test:connector:file-leads": "cross-env NODE_ENV=test tsx src/connectors/file-lead-ingestion-connector-test.ts",
    "test:connector:web-leads": "cross-env NODE_ENV=test tsx src/connectors/web-lead-ingestion-connector-test.ts"
  },
  "dependencies": {
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "1.4.8",
    "@langchain/langgraph-checkpoint": "1.1.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.22.5",
    "nodemailer": "^9.0.3",
    "qrcode-terminal": "^0.12.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.0.2",
    "whatsapp-web.js": "^1.34.7",
    "zod": "3.25.76",
    "@goodjob/workbook-security": "0.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
